# Server
PORT=8080

# Database (Supabase PostgreSQL)
DB_HOST=aws-1-eu-central-1.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.qslnfhnnzsfmtnochnce
DB_PASS=your-db-password
DB_NAME=postgres
DB_SSLMODE=require

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# AES encryption (for legacy password compatibility)
AES_SALT=RZ8HU1EB

# SMS (smsoffice.ge)
SMS_API_KEY=your-sms-api-key
SMS_SENDER=V E T A P P

# Resend (https://resend.com) — transactional email for email verification.
# Until you verify a sending domain in the Resend dashboard, RESEND_FROM
# must use the sandbox `onboarding@resend.dev` address (and Resend will
# only deliver to the account owner's email).
RESEND_API_KEY=
RESEND_FROM=VetApp <onboarding@resend.dev>
# Optional: public base URL the verification link points back to.
# Defaults to BASE_URL when empty.
EMAIL_VERIFY_BASE_URL=
SMS_URL=https://smsoffice.ge/api/v2/send

# --- Card payments ---
#
# Two gateways are supported, BOTH operated by Bank of Georgia:
#
#   bog  — the current Payments API (api.bog.ge). Use this.
#   ipay — the previous generation. BOG's own docs state
#          "Ipay integration is no longer available", so it is kept
#          only to settle in-flight orders and as a fallback.
#
# PAYMENT_PROVIDER picks which one NEW checkouts use. Leave it unset
# and the server prefers "bog" whenever BOG credentials are present,
# falling back to "ipay" when they are not — so filling in the BOG
# values below is all that's needed to switch over.
PAYMENT_PROVIDER=

# Bank of Georgia Payments API.
# Credentials come from https://businessmanager.bog.ge
BOG_CLIENT_ID=your-bog-client-id
BOG_SECRET_KEY=your-bog-secret
BOG_API_URL=https://api.bog.ge
BOG_AUTH_URL=https://oauth2.bog.ge
# BOG's RSA public key (PEM) used to verify the `Callback-Signature`
# webhook header. Optional but recommended. A single line with literal
# \n escapes is accepted, which is how most dashboards store multi-line
# secrets. When unset, callbacks are treated as unverified hints and the
# authoritative payment status is re-fetched from BOG instead.
BOG_PUBLIC_KEY=

# iPay.ge — LEGACY, see the note above.
IPAY_CLIENT_ID=your-ipay-client-id
IPAY_SECRET_KEY=your-ipay-secret
IPAY_URL=https://ipay.ge
